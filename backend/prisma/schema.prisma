generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Subject {
  id        String   @id @default(cuid())
  userId    String   @default("legacy_user")
  title     String
  topics    Int      @default(0)
  tags      String[]
  content   String   @default("")
  imageUrls String[] @default([])
  aiSummary String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flashcard {
  id         String   @id @default(cuid())
  userId     String   @default("legacy_user")
  front      String
  back       String
  difficulty String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Goal {
  id        String   @id @default(cuid())
  userId    String   @default("legacy_user")
  label     String
  detail    String
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarEvent {
  id        String   @id @default(cuid())
  userId    String   @default("legacy_user")
  title     String
  date      String
  time      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PhilosophyTheme {
  id           String   @id @default(cuid())
  userId       String   @default("legacy_user")
  theme        String
  focus        String
  insight      String
  philosophers String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Reflection {
  id           String   @id @default(cuid())
  userId       String   @default("legacy_user")
  title        String
  content      String
  philosophers String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PomodoroSession {
  id          String   @id @default(cuid())
  userId      String   @default("legacy_user")
  label       String
  minutes     Int
  completedAt DateTime
  createdAt   DateTime @default(now())
}
